# Copier ce fichier en ".env.local" puis remplir les valeurs.
# .env.local est ignoré par Git : ne jamais y mettre de secret dans le code.

# --- Site ---
# URL publique du site (sans "/" final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (Phase 2) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Jeton en lecture (seulement si besoin de brouillons / aperçu). Secret !
SANITY_API_READ_TOKEN=
# Secret partagé avec le webhook Sanity pour la revalidation. Secret !
SANITY_REVALIDATE_SECRET=

# --- Formspree (Phase 5) ---
# Identifiant du formulaire (la partie après https://formspree.io/f/)
FORMSPREE_FORM_ID=
